{
  "name": "flow-forge-backend",
  "version": "0.0.1",
  "private": true,
  "description": "FlowForge API and worker",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check-node": "node -e \"console.log('Node', process.version)\"",
    "typecheck": "tsc --noEmit",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "tsc",
    "check-config": "npm run build && node --env-file=.env dist/check-config.js",
    "check-db": "npm run build && node --env-file=.env dist/check-db.js",
    "migrate": "npm run build && node --env-file=.env dist/db/migrate.js",
    "start": "npm run build && node --env-file=.env dist/api/main.js",
    "start:worker": "npm run build && node --env-file=.env dist/worker/main.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@node-rs/argon2": "^2.2.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bullmq": "^6.3.19",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.15.0",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
}
